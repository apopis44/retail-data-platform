POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=retail
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=change_me

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PREFIX=retail
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

DEBEZIUM_URL=http://debezium:8083
DEBEZIUM_CONNECTOR_NAME=postgres-retail-cdc
DEBEZIUM_HEARTBEAT_TOPIC=retail.heartbeat
DEBEZIUM_HEARTBEAT_INTERVAL_MS=30000

POSTGRES_PUBLICATION_NAME=retail_cdc
POSTGRES_REPLICATION_SLOT_NAME=retail_cdc_slot

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_ADC_PATH=/absolute/path/to/application_default_credentials.json